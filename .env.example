DUMMYJSON_BASE_URL=https://dummyjson.com
# 可选：指定用于登录的测试账号（DummyJSON公开用户）
DUMMYJSON_USERNAME=emilys
DUMMYJSON_PASSWORD=emilyspass
# Allure结果目录（默认：allure-results）
ALLURE_RESULTS_DIR=allure-results
# Allure命令行路径（Windows示例）
ALLURE_PATH=F:\allure-commandline-2.35.1\allure-2.35.1\bin\allure.bat

# HTTP 配置（可选）
HTTP_TIMEOUT_SECONDS=30
# 遇到网络抖动/429/5xx 时自动重试次数（含首次）
HTTP_RETRY_ATTEMPTS=2
# 重试退避基数（秒），会做指数退避 + 随机抖动
HTTP_RETRY_BACKOFF_BASE_SECONDS=0.3
