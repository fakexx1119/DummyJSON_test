# DummyJSON API 配置
DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_USERNAME=你的用户名
DUMMYJSON_PASSWORD=你的密码

# 说明：
# 1. 如果是本地开发，复制此文件为 .env，并填入真实配置
# 2. 如果是 GitHub Actions，会在 Secrets 中读取
# 3. DummyJSON 公开测试账号：emilys / emilyspass
#    来源：https://dummyjson.com/docs/auth

# Allure 配置（可选）
ALLURE_RESULTS_DIR=allure-results
ALLURE_PATH=你的 allure 路径（可选）

# HTTP 配置（可选）
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRY_ATTEMPTS=2
HTTP_RETRY_BACKOFF_BASE_SECONDS=0.3
